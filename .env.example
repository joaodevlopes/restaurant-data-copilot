# Modelo de variáveis de ambiente.
# Gere o .env real com:  powershell -ExecutionPolicy Bypass -File scripts/new-env.ps1
# O script troca cada "change-me" por uma senha aleatória. Nunca commite o .env.

# --- PostgreSQL: superusuário, usado só na primeira inicialização do banco ---
POSTGRES_DB=restaurant_copilot
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Usuários de aplicação (privilégio mínimo) ---
# loader: Python carrega a Silver no schema silver
LOADER_USER=loader
LOADER_PASSWORD=change-me
# transformer: dbt lê silver e escreve gold
TRANSFORMER_USER=transformer
TRANSFORMER_PASSWORD=change-me
# api_reader: Spring Boot só lê gold
API_READER_USER=api_reader
API_READER_PASSWORD=change-me

# --- Endereço do banco para quem roda no host (Python, dbt, API) ---
DB_HOST=127.0.0.1
