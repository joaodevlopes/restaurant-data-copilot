# ---------------------------------------------------------------
# Segredos: nunca versionar. Apenas o modelo .env.example entra.
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Dados: só a estrutura de pastas e os manifests entram no Git.
# Os dados são reproduzíveis pelo pipeline (seed fixa + fontes).
# ---------------------------------------------------------------
data/**
!data/**/
!data/**/.gitkeep
!data/bronze/manifests/*.json

